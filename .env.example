# Copy this file to .env (used by `vercel dev` for local testing) and fill in real values.
# Never commit your real .env file — it's already in .gitignore.

RESEND_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=gokulk804@gmail.com
# Optional — only needed once you've verified your own domain in Resend.
# Until then, leave unset and it defaults to Resend's shared onboarding@resend.dev sender.
# CONTACT_FROM_EMAIL=Portfolio Contact <hello@yourdomain.com>

# Supabase — from Project Settings → API. The service_role key is SECRET: server-side only,
# never prefix it with VITE_ or reference it from frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key
